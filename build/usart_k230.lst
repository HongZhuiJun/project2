  64:bsp/usart/usart_k230.c **** /**
  65:bsp/usart/usart_k230.c ****  * @brief 重新挂载接收（中断 / DMA-Normal 模式使用）。
  66:bsp/usart/usart_k230.c ****  *
  67:bsp/usart/usart_k230.c ****  * @return HAL_OK 表示重挂成功；失败会累加到 error_count，供上层发现。
  68:bsp/usart/usart_k230.c ****  *
  69:bsp/usart/usart_k230.c ****  * @note HAL 在调用 HAL_UARTEx_RxEventCallback() / HAL_UART_ErrorCallback()
  70:bsp/usart/usart_k230.c ****  *       之前已经把 RxState 复位成 READY 并结束了上一轮接收，
  71:bsp/usart/usart_k230.c ****  *       所以在这两个回调里可以直接重挂，不需要先 Abort。
  72:bsp/usart/usart_k230.c ****  * @note Circular 模式 DMA 不会停，不需要（也不应该）调用本函数。
  73:bsp/usart/usart_k230.c ****  */
  74:bsp/usart/usart_k230.c **** static HAL_StatusTypeDef K230UsartRearm(K230UsartInstance *instance)
  75:bsp/usart/usart_k230.c **** {
ARM GAS  C:\Users\LJH\AppData\Local\Temp\ccpVB3Vp.s 			page 5


  76:bsp/usart/usart_k230.c ****     HAL_StatusTypeDef status;
  77:bsp/usart/usart_k230.c **** 
  78:bsp/usart/usart_k230.c ****     if (instance->rx_mode == K230_USART_RX_MODE_IT) {
  79:bsp/usart/usart_k230.c ****         status = HAL_UARTEx_ReceiveToIdle_IT(instance->uart_handle,
  80:bsp/usart/usart_k230.c ****                                              instance->rx_buf,
  81:bsp/usart/usart_k230.c ****                                              instance->rx_buf_size);
  82:bsp/usart/usart_k230.c ****     } else {
  83:bsp/usart/usart_k230.c ****         status = HAL_UARTEx_ReceiveToIdle_DMA(instance->uart_handle,
  84:bsp/usart/usart_k230.c ****                                               instance->rx_buf,
  85:bsp/usart/usart_k230.c ****                                               instance->rx_buf_size);
  86:bsp/usart/usart_k230.c ****     }
  87:bsp/usart/usart_k230.c **** 
  88:bsp/usart/usart_k230.c ****     if (status != HAL_OK) {
  89:bsp/usart/usart_k230.c ****         /* 重挂失败说明串口状态异常，计数后由上层通过 error_count 发现 */
  90:bsp/usart/usart_k230.c ****         instance->error_count++;
  91:bsp/usart/usart_k230.c ****     }
  92:bsp/usart/usart_k230.c **** 
  93:bsp/usart/usart_k230.c ****     return status;
  94:bsp/usart/usart_k230.c **** }
