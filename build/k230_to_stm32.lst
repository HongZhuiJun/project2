 246:modules/k230_to_stm32.c ****         .parent      = instance,
 247:modules/k230_to_stm32.c ****         .rx_callback = K230ToStm32OnRxData,
 248:modules/k230_to_stm32.c ****     };
 249:modules/k230_to_stm32.c **** 
 250:modules/k230_to_stm32.c ****     instance->usart_instance = K230UsartRegister(&usart_config);
 251:modules/k230_to_stm32.c ****     if (instance->usart_instance == NULL) {
 252:modules/k230_to_stm32.c ****         return NULL;
 253:modules/k230_to_stm32.c ****     }
 254:modules/k230_to_stm32.c **** 
 255:modules/k230_to_stm32.c ****     return instance;
 256:modules/k230_to_stm32.c **** }
