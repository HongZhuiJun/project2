 215:modules/k230_to_stm32.c ****  * @return 默认实例指针；尚未初始化或初始化失败时返回 NULL。
 216:modules/k230_to_stm32.c ****  */
 217:modules/k230_to_stm32.c **** K230ToStm32Instance *K230ToStm32GetInstance(void)
 218:modules/k230_to_stm32.c **** {
