 258:modules/k230_to_stm32.c **** uint8_t K230ToStm32Start(K230ToStm32Instance *instance)
 259:modules/k230_to_stm32.c **** {
 260:modules/k230_to_stm32.c ****     if (instance == NULL) {
 261:modules/k230_to_stm32.c ****         return 0u;
 262:modules/k230_to_stm32.c ****     }
 263:modules/k230_to_stm32.c **** 
 264:modules/k230_to_stm32.c ****     return (K230UsartStart(instance->usart_instance) == HAL_OK) ? 1u : 0u;
 265:modules/k230_to_stm32.c **** }
